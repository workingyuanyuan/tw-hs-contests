  "deliverables": [
    {
      "stage": "報名",
      "what": "報名表、加蓋註冊章之學生證影本（或在學證明聲明書）、個人資料提供同意書及肖像權使用同意書",
      "how": "online"
    },
    {
      "stage": "初賽",
      "what": "1.5 小時單選題作答，範圍含逆向工程、網站、Pwn、加解密、鑑識等，使用主辦單位提供之電腦",
      "how": "onsite"
    },
    {
      "stage": "決賽（入圍隊伍）",
      "what": "5 小時解謎式（Jeopardy）解題，取得試題金鑰填答於競賽系統，自備電腦與解題工具",
      "how": "onsite"
    }
  ],
