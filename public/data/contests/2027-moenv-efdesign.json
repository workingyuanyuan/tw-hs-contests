  "deliverables": [
    {
      "stage": "初審",
      "what": "A2 橫式展示看板（至多 3 張，含設計圖面及設計說明；初審入圍者須繳交 300 dpi JPG 影像檔）",
      "how": "online"
    },
    {
      "stage": "決審第一階段",
      "what": "A2 橫式展示看板 2 張（AI 檔及 300 dpi JPG/PNG 檔）、設計特點說明影片（MP4、90–150 秒、1080p 以上）及簡報",
      "how": "online"
    },
    {
      "stage": "決審第二階段",
      "what": "500mm×500mm×500mm 範圍內實際比例模型/原型，及現場口頭簡報 7 分鐘（評審提問 6 分鐘）",
      "how": "onsite"
    }
  ],
