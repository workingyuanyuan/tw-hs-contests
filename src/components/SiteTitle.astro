---
// Override of Starlight's SiteTitle: the site name and a link to the first page of each
// top-level sidebar group (依截止月份, 依類別, 封存), in the sidebar's order and labels.
// The Markdown twin, llms.txt and index.json are linked from the page notes
// (MarkdownContent.astro).
import { TITLE, LABELS, localeOf } from '../lib/site.mjs';

const { siteTitleHref, entry, sidebar } = Astro.locals.starlightRoute;
const locale = localeOf(entry.id);
const t = LABELS[locale.lang];
const links = (entries) => entries.flatMap((e) => (e.type === 'link' ? [e] : links(e.entries)));
const groups = sidebar
	.filter((e) => e.type === 'group')
	.map((group) => {
		const inner = links(group.entries);
		return { label: group.label, href: inner[0]?.href, current: inner.some((e) => e.isCurrent) };
	})
	.filter((s) => s.href);
// A site with one section shows no section links (root AGENTS.md, Visible page).
const sections = groups.length > 1 ? groups : [];
---

<a href={siteTitleHref} class="site-title">{TITLE[locale.lang]}</a>
{sections.length > 0 && <nav class="sections" aria-label={t.sections}>
	{sections.map((s) => <a href={s.href} aria-current={s.current ? 'true' : undefined}>{s.label}</a>)}
</nav>}

<style>
	.site-title {
		display: flex;
		align-items: center;
		font-size: var(--sl-text-h4);
		text-decoration: none;
		white-space: nowrap;
	}
	.sections {
		display: none;
		gap: 1.25rem;
		margin-inline-start: 1.5rem;
		font-size: var(--sl-text-sm);
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.sections {
			display: flex;
			align-items: center;
		}
	}
	.sections a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	/* The section of the current page: ink and a red rule, no drawn text. */
	.sections a[aria-current] {
		color: var(--sl-color-white);
		box-shadow: inset 0 -2px 0 var(--sl-color-text-accent);
	}
	.sections a:hover,
	.sections a:focus-visible {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}
</style>
