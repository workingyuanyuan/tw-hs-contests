    },
    {
      "stage": "A1 導覽解說影片設計組（報名時）",
      "what": "在原鄉地點自行拍攝的 2–3 分鐘影片（MP4/AVI/MOV，至少 1280×960），上傳 YouTube 設為不公開並寄出連結",
      "how": "online"
    },
    {
      "stage": "A1 導覽解說影片設計組（現場）",
      "what": "現場播放作品發表，接受評審 2 分鐘提問",
      "how": "onsite"
    },
    {
      "stage": "A2 創意蛋糕裝飾組（現場）",
      "what": "120 分鐘內以原民特色食材裝飾 8 吋圓形或 20 公分正方單層蛋糕，附 A4 立牌並分享創作理念約 3 分鐘",
      "how": "onsite"
    },
    {
      "stage": "B1 原住民果醬畫盤藝術展示",
      "what": "以可食性材料完成的單一展示盤畫盤作品及說明卡，於指定時間內陳列",
      "how": "onsite"
    },
    {
      "stage": "B2 原住民果凍花藝術展示",
      "what": "以透明或半透明果凍為主要媒材的立體作品及說明卡，於指定時間內陳列",
      "how": "onsite"
    },
    {
      "stage": "B3 原住民伴手禮設計組",
      "what": "1000 字以內作品簡介及創作理念（含市場推廣評估）與作品照片 3–5 張",
      "how": "unknown"
    },
    {
      "stage": "B3 原住民伴手禮設計組（現場）",
      "what": "攤位上 2 分鐘產品口頭介紹及委員問答",
      "how": "onsite"
    },
    {
      "stage": "B4 翻糖蛋糕裝飾組（現場）",
      "what": "60 分鐘內完成不低於 25 公分的翻糖蛋糕，附 A4 立牌並分享創作理念約 3 分鐘",
      "how": "onsite"
    },
    {
      "stage": "B5 原住民手指小食展示",
      "what": "4 款手指小食各 4 件共 16 件，另備評審檢視盤 1 盤，並布置展台",
      "how": "onsite"
    }
  ],
