  "ai_policy": {
    "value": "restricted",
    "basis": "quote",
    "evidence": [
      {
        "url": "https://prj.gamer.com.tw/acgaward/2027/anime_rule/",
        "quote": "為確保比賽的公平性與作品之完整著作權歸屬，禁止生成式 AI 技術之使用。"
      },
      {
        "url": "https://forum.gamer.com.tw/C.php?bsn=60550&snA=96&tnum=1",
        "quote": "參賽作品禁止使用生成式 AI 產出美術、動畫、音樂、音效、劇情、對白、文字等創作素材。"
      },
      {
        "url": "https://forum.gamer.com.tw/C.php?bsn=60550&snA=96&tnum=1",
        "quote": "惟不涉及作品內容生成之輔助用途，如創意諮詢、劇情分析及作品評論等，不在此限，作品的實際創作內容仍須由參賽者自行完成。"
      },
      {
        "url": "https://forum.gamer.com.tw/C.php?bsn=60550&snA=96&tnum=1",
        "quote": "遊戲組允許使用 AI 輔助程式開發，包括程式除錯、技術諮詢、效能優化及部分程式碼撰寫等用途。"
      },
      {
        "url": "https://forum.gamer.com.tw/C.php?bsn=60550&snA=96&tnum=1",
        "quote": "若有使用生成式 AI 協助撰寫程式碼，須於報名時如實揭露使用情形。"
      }
    ]
  },
